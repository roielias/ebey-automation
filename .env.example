# E-commerce E2E Automation - Environment Configuration
# Copy this file to .env and update with your values

# ===== Application URLs =====
BASE_URL=https://www.ebay.com

# ===== Authentication (Optional) =====
# Leave empty to run in guest mode (recommended for eBay)
EBAY_USERNAME=
EBAY_PASSWORD=
USE_GUEST_MODE=True

# ===== Browser Settings =====
# Options: chromium, firefox, webkit
BROWSER=chromium

# Run browser in headless mode (no UI)
# Options: True, False
HEADLESS=False

# ===== Timeouts (milliseconds) =====
TIMEOUT=30000

# ===== Screenshot Settings =====
SCREENSHOT_ON_FAILURE=True

# ===== Test Environment =====
ENVIRONMENT=dev
